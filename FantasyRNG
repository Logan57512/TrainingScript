task.spawn(function()
    -- wait for the game to finish loading
    local pg = LocalPlayer:WaitForChild("PlayerGui")
    local t0 = os.clock()
    while alive and (not pg:FindFirstChild("Root") or pg:GetAttribute("LoadingActive")) and os.clock() - t0 < 30 do
        task.wait(0.5)
    end
    if not alive then return end
    task.wait(0.5)

    track(Event.OnClientEvent:Connect(dispatch))
    Event:FireServer("Raid", { Op = "Watch" })

    if cfg.tower then startTower() end

    -- roll loop (unchanged)
    task.spawn(function()
        while alive do
            if cfg.roll then
                Event:FireServer("Roll")
                task.wait(ROLL_DELAY)
            else
                task.wait(0.2)
            end
        end
    end)

    -- raid combat loop (attack / shield timing)
    task.spawn(function()
        while alive do
            local ok, err = pcall(raidTick)
            if not ok and DEBUG then warn("[FD raid tick]", err) end
            task.wait(0.05)
        end
    end)

    -- one low-frequency loop: watchdogs + raid lobby + quests + stat refresh (no per-frame work)
    local tick = 0
    while alive do
        task.wait(0.5)
        local now = os.clock()
        tick += 1
        if tick % 10 == 0 then checkQuests() end
        pcall(raidManage)

        if cfg.tower and not (raidBusy or raidJoining) then
            if inRun and now - lastTowerEvt > 90 then
                inRun = false            -- lost sync: resume
                startTower()
            elseif not inRun and not tradeBusy and now - lastStartSent > 3 then
                startTower()             -- start was dropped / ignored
            end
        end

        if not minimized then refresh() end
    end
end)

