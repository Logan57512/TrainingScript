local function applyWindow(animate)
    toggle.BackgroundColor3 = minimized and PANEL or ON_C
    toggle.TextColor3 = minimized and DIM or Color3.new(1, 1, 1)
    frame.Visible = not minimized
    if not minimized then
        refresh()
        if animate then
            pop.Scale = 0.92
            tween(pop, 0.15, { Scale = 1 })
        end
    end
end

