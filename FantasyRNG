--[[
    Fantasy Dice - Auto Tower + Auto Roll + Auto Raid + Auto Quests (single script)

    Tower mode (switch in the UI):  All Towers (every tower in TowerConfig, by `order`)  |  Infinity (Infinity Tower only)
    Towers ALWAYS start on the strongest difficulty (TOWER_DIFFICULTY = "Nightmare") at the highest speed you own
    (x3 with the Tower Speed gamepass, otherwise x2).

    Protocol (from FantasyDiceClient / TowerClient / RaidClient / RaidBattle / RaidEntry):
      Roll  : FireServer("Roll") -> ("Rolled", {Token}) -> FireServer("RollLanded", Token)
              ("RollRejected") when refused
      Tower : FireServer("Tower", {Op="Start", Name=<TowerConfig key>, Auto=true, Difficulty="Nightmare", Speed=2|3})
              ("TowerEvent", {Action = started|floorStarted|...|ended|startRejected})
              ("TradeEvent", {Kind="Ended"}) clears a TradeBusy rejection
      Quest : FireServer("Feature", {Op="QuestClaim", Period, Id, ExpiresAt, RequestId}) -> ("QuestResult", {...})
      Raid  : FireServer("Raid", {Op="Watch"})                          -> ("RaidState", state)
              FireServer("Raid", {Op="Join", Uid=<unit uid>})           (must be inside ServerRaid.RaidJoinCircle)
              FireServer("Raid", {Op="Strike", Serial=state.Serial})    (attack, ~0.5s cooldown, not while shielding)
              FireServer("Raid", {Op="Shield", Serial=..., Held=bool})  (hold during a boss slam: state.WindowStart ~= nil)
              ("RaidNotice", msg) / ("RaidLeft") / ("RaidUnitReward", {Id, Quantity})

    Auto Reconnect persistence: to keep the script running after the rejoin, either put it in your executor's
    autoexec folder, or save it as  FantasyDice_Auto.lua  in the executor workspace (it is queued on teleport),
    or set SCRIPT_URL below.
]]

local SCRIPT_URL = ""                       -- optional: raw URL of this script for queue_on_teleport
local SCRIPT_FILE = "FantasyDice_Auto.lua"  -- optional: workspace filename of this script
local CFG_FILE = "FantasyDice_AutoConfig.json"

local TOWER_DIFFICULTY = "Nightmare"        -- strongest mode in TowerModes (Normal < Hard < Nightmare)
local RAID_MAX_ATTEMPTS = 5                 -- join attempts per raid lobby before giving up
local RAID_RETURN_AFTER_JOIN = true         -- teleport back to where you were once queued
local RAID_SKIP_TOWER_TEAM = false          -- true = never pick a unit that is in your tower team
local DEBUG = false                         -- print raid traffic / notices

