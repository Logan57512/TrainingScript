----------------------------------------------------------------------
-- Roll (fixed interval, animation skipped)  -- unchanged
--   a "Roll" request every ROLL_DELAY seconds; each "Rolled" is acknowledged with "RollLanded(token)" at once
----------------------------------------------------------------------
local function onRolled(d)
    rolls += 1
    if type(d) == "table" and d.Token ~= nil then
        Event:FireServer("RollLanded", d.Token)
    end
end

local function onRollRejected()
    rejects += 1
end

----------------------------------------------------------------------
-- Tower (restart immediately after "ended", always Nightmare, fastest speed)
----------------------------------------------------------------------
local function towerSpeed()
    local perks = playerState.OwnedPerks
    if type(perks) == "table" and perks["Tower Speed"] == true then return 3 end
    return 2 -- speed 3 needs the Tower Speed gamepass; 2 is free
end

local function pickTower()
    local n = #towers
    for i = 0, n - 1 do
        local k = (tIdx - 1 + i) % n + 1
        if (blocked[towers[k]] or 0) <= os.clock() then
            tIdx = k
            return towers[k]
        end
    end
end

local function advance()
    if #towers > 1 then tIdx = tIdx % #towers + 1 end
end

local function startTower()
    if not (alive and cfg.tower) or inRun or tradeBusy or raidBusy or raidJoining then return end
    local name = pickTower()
    if not name then
        towerNote = "all towers locked, retrying"
        task.delay(5, startTower)
        return
    end
    towerNote = ""
    lastTowerName = name
    lastStartSent = os.clock()
    Event:FireServer("Tower", {
        Op = "Start",
        Name = name,
        Auto = true,
        Difficulty = TOWER_DIFFICULTY,
        Speed = towerSpeed(),
    })
end

local function onTowerEvent(d)
    if type(d) ~= "table" then return end
    lastTowerEvt = os.clock()
    local a = d.Action
    if a == "started" then
        inRun = true
        retryDelay = 0.5
        curName = d.Name or lastTowerName
        curDiff = d.Difficulty or "?"
        curSpeed = d.Speed or 1
        floorNo = 1
        if curDiff ~= TOWER_DIFFICULTY then
            towerNote = "server ran " .. tostring(curDiff) .. " (wanted " .. TOWER_DIFFICULTY .. ")"
        end
    elseif a == "floorStarted" then
        floorNo = d.Floor or floorNo
    elseif a == "ended" then
        inRun = false
        runs += 1
        if cfg.tower then
            advance()
            startTower()
        end
    elseif a == "startRejected" and cfg.tower then
        if d.Code == "TradeBusy" then
            tradeBusy = true
            towerNote = "trade busy, waiting"
        elseif d.Retryable == false then
            blocked[lastTowerName] = os.clock() + 30
            towerNote = tostring(d.Reason or "start refused")
            advance()
            task.delay(0.3, startTower)
        else
            retryDelay = math.min(3, retryDelay * 1.5)
            task.delay(retryDelay, startTower)
        end
    end
end

----------------------------------------------------------------------
-- Auto claim quests (native, no UI)
--   FireServer("Feature", {Op="QuestClaim", Period, Id, ExpiresAt, RequestId})  ->  ("QuestResult", {RequestId, Quests, ...})
--   Quest state arrives in ("State", {Quests = {Daily|Weekly = {progress, claimed, expiresAt}}})
--   QuestConfig already contains the raid quests (RaidBlocks / RaidWins / RaidParticipation / RaidStrikes).
----------------------------------------------------------------------
local questReq = 1000000        -- high range so ids never collide with the game's own UI counter
local questPending, questPendingAt = nil, 0
local lastQuestCheck = 0

local function checkQuests()
    local questState = playerState.Quests
    if not (alive and cfg.quests and QuestConfig and type(questState) == "table") then return end
    if questPending and os.clock() - questPendingAt < 3 then return end
    questPending = nil
    lastQuestCheck = os.clock()

    for _, period in ipairs({ "Daily", "Weekly" }) do
        local q, pcfg = questState[period], QuestConfig.Periods[period]
        if type(q) == "table" and pcfg then
            if type(q.expiresAt) == "number" and q.expiresAt <= os.time() then continue end -- stale, wait for reset
            local claimed, progress = q.claimed or {}, q.progress or {}
            for _, quest in ipairs(pcfg.quests) do
                if not claimed[quest.id] and (progress[quest.id] or 0) >= quest.target then
                    questReq += 1
                    questPending, questPendingAt = questReq, os.clock()
                    Event:FireServer("Feature", {
                        Op = "QuestClaim",
                        Period = period,
                        Id = quest.id,
                        ExpiresAt = q.expiresAt,
                        RequestId = questReq,
                    })
                    return -- one at a time; the result triggers the next
                end
            end
        end
    end
end

----------------------------------------------------------------------
-- Auto Raid
--   1) lobby open (mirrors RaidEntry.available) -> go into RaidJoinCircle, pick the strongest unit, Join
--   2) battle -> Strike every attack cooldown; hold Shield while a slam window is active (full block)
--   3) tower is paused while fighting, resumes afterwards
----------------------------------------------------------------------
local function myMember(s)
    if type(s) ~= "table" or type(s.Members) ~= "table" then return nil end
    for _, m in ipairs(s.Members) do
        if m.UserId == LocalPlayer.UserId then return m end
    end
end

local function onRaidState(s)
    if type(s) ~= "table" then return end
    local prev = raidState
    raidState, raidStateAt = s, os.clock()
    local me = myMember(s)
    local was = raidBusy
    raidBusy = me ~= nil and (s.Phase == "Battle" or s.Phase == "Results")

    if s.Phase == "Results" and me and not (prev and prev.Phase == "Results") then
        if (s.Health or 1) <= 0 then raidWins += 1 else raidLosses += 1 end
    end
    if was and not raidBusy then
        shieldHeld = false
        if cfg.tower then task.defer(startTower) end
    end
end

local function sendShield(held)
    local s = raidState
    if s then
        Event:FireServer("Raid", { Op = "Shield", Serial = s.Serial, Held = held })
    end
    shieldHeld = held
    lastShield = os.clock()
end

local function sendStrike()
    local s = raidState
    if not s then return end
    Event:FireServer("Raid", { Op = "Strike", Serial = s.Serial })
    raidStrikes += 1
    nextStrike = os.clock() + ATTACK_CD
end

local function raidTick()
    local now = os.clock()
    if raidBusy and now - raidStateAt > 8 then -- lost the raid feed, release the tower
        raidBusy = false
        shieldHeld = false
        if cfg.tower then task.defer(startTower) end
    end

    local s = raidState
    local me = cfg.raid and raidBusy and s and s.Phase == "Battle" and myMember(s)
    if not (me and (me.Health or 0) > 0) then
        if shieldHeld then sendShield(false) end
        if raidBusy and now - lastWatch > 2 and now - raidStateAt > 2 then
            lastWatch = now
            Event:FireServer("Raid", { Op = "Watch" })
        end
        return
    end

    local serverNow = workspace:GetServerTimeNow()
    local slam = s.WindowStart ~= nil and (s.WindowEnd == nil or serverNow < s.WindowEnd + 0.5)
    if slam then
        if not shieldHeld or now - lastShield > 0.35 then sendShield(true) end -- lease is ~1.2s, renew like the real client
    elseif shieldHeld then
        sendShield(false)
        nextStrike = now + ATTACK_RECOVERY
    elseif now >= nextStrike then
        sendStrike()
    end
end

local function raidAvailable()
    local sr = workspace:FindFirstChild("ServerRaid")
    if not sr then return false end
    local boss = sr:FindFirstChild("Boss")
    local startsAt = sr:GetAttribute("RaidStartsAt")
    if sr:GetAttribute("RaidPhase") ~= "Lobby" or not boss then return false end
    if boss:GetAttribute("Defeated") then return false end
    return type(startsAt) == "number" and workspace:GetServerTimeNow() < startsAt
end

local function isQueued()
    local s = raidState
    if s and os.clock() - raidStateAt < 15 and s.Phase == "Lobby" then
        return myMember(s) ~= nil
    end
    return LocalPlayer:GetAttribute("RaidQueuedUnit") ~= nil
end

-- strongest unit by the same damage formula TowerClient shows (Odds^0.58 * damageMultiplier)
local function bestUnits(limit)
    local st = playerState
    local out, team = {}, {}
    if RAID_SKIP_TOWER_TEAM and type(st.TowerTeam) == "table" then
        for _, uid in pairs(st.TowerTeam) do team[uid] = true end
    end
    local function consider(id, rec)
        if type(rec) ~= "table" or not rec.Uid or team[rec.Uid] then return end
        local base = GameConfig and GameConfig.ById and GameConfig.ById[id]
        if not base then return end
        local ok, score = pcall(function()
            local u = MutationSystem.Resolve(base, rec)
            return (u.Odds or base.Odds or 0) ^ 0.58 * UnitInventory.Multiplier(rec, "damageMultiplier")
        end)
        if not ok or type(score) ~= "number" then score = base.Odds or 0 end
        table.insert(out, { Uid = rec.Uid, Id = id, Score = score })
    end
    for id, list in pairs(st.InventoryRecords or {}) do
        if type(list) == "table" then
            for _, rec in ipairs(list) do consider(id, rec) end
        end
    end
    for k, rec in pairs(st.SlotRecords or {}) do
        local id = (st.Slots or {})[k]
        if id then consider(id, rec) end
    end
    table.sort(out, function(a, b) return a.Score > b.Score end)
    while #out > limit do table.remove(out) end
    return out
end

local function gotoCircle()
    local sr = workspace:FindFirstChild("ServerRaid")
    local circle = sr and sr:FindFirstChild("RaidJoinCircle")
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (circle and hrp) then return false end
    local radius = circle:GetAttribute("JoinRadius") or RaidCfg.JoinRadius or 23
    local d = hrp.Position - circle.Position
    if Vector2.new(d.X, d.Z).Magnitude < radius - 4 and math.abs(d.Y) < 10 then return false end
    char:PivotTo(CFrame.new(circle.Position + Vector3.new(0, 3, 0)))
    task.wait(0.6)
    return true
end

-- attempt plan: best unit, best unit after cancelling the tower run, 2nd best, 3rd best, best again after cancel
local PLAN = { { 1, false }, { 1, true }, { 2, false }, { 3, false }, { 1, true } }

local function attemptJoin()
    if raidJoining then return end
    raidJoining = true
    task.spawn(function()
        raidAttempts += 1
        raidNext = os.clock() + 4
        local step = PLAN[math.min(raidAttempts, #PLAN)]
        local cands = bestUnits(3)
        local cand = cands[step[1]] or cands[1]
        if not cand then
            raidNote = "raid: no unit found in state"
            raidJoining = false
            return
        end

        local char = LocalPlayer.Character
        local home = char and char:GetPivot()
        local moved = gotoCircle()
        Event:FireServer("Raid", { Op = "Watch" })
        task.wait(0.4)
        if step[2] and inRun then
            Event:FireServer("Tower", { Op = "Cancel" })
            task.wait(0.7)
        end
        Event:FireServer("Raid", { Op = "Join", Uid = cand.Uid })

        local t0 = os.clock()
        while alive and os.clock() - t0 < 3 and not isQueued() do task.wait(0.2) end

        if isQueued() then
            raidJoined = true
            raidJoins += 1
            raidNote = ""
        else
            raidNote = string.format("raid join failed (%d/%d)", raidAttempts, RAID_MAX_ATTEMPTS)
        end

        if moved and RAID_RETURN_AFTER_JOIN and raidJoined and home then
            local c = LocalPlayer.Character
            if c then pcall(function() c:PivotTo(home) end) end
        end

        raidJoining = false
        if cfg.tower then startTower() end
    end)
end

local function raidManage()
    if not cfg.raid or raidJoining or raidBusy then return end
    local now = os.clock()
    if not raidAvailable() then
        raidAttempts, raidJoined, lobbySeen = 0, false, 0
        return
    end
    if lobbySeen == 0 then lobbySeen = now end

    -- make sure we have a fresh state first (Watch); fall back to the player attribute after 4s
    local fresh = raidState and now - raidStateAt < 15 and raidState.Phase == "Lobby"
    if not fresh then
        if now - lastWatch > 2 then
            lastWatch = now
            Event:FireServer("Raid", { Op = "Watch" })
        end
        if now - lobbySeen < 4 then return end
    end

    if isQueued() then
        raidJoined = true
        return
    end
    raidJoined = false
    if raidAttempts >= RAID_MAX_ATTEMPTS or now < raidNext then return end
    attemptJoin()
end

----------------------------------------------------------------------
-- Remote dispatcher
----------------------------------------------------------------------
local function dispatch(kind, data)
    if DEBUG and type(kind) == "string" and kind:sub(1, 4) == "Raid" then
        print("[FD raid]", kind, typeof(data) == "table" and (data.Phase or "") or data)
    end

    if kind == "Rolled" then
        if cfg.roll then onRolled(data) end
    elseif kind == "RollRejected" then
        if cfg.roll then onRollRejected() end
    elseif kind == "TowerEvent" then
        onTowerEvent(data)
    elseif kind == "State" then
        if type(data) == "table" then
            playerState = data
            if os.clock() - lastQuestCheck > 2 then task.defer(checkQuests) end
        end
    elseif kind == "QuestResult" then
        if type(data) == "table" then
            if type(data.Quests) == "table" then playerState.Quests = data.Quests end
            if type(data.Items) == "table" then playerState.Items = data.Items end
            if type(data.OwnedPerks) == "table" then playerState.OwnedPerks = data.OwnedPerks end
            if data.RequestId == questPending then questPending = nil end
            task.defer(checkQuests)
        end
    elseif kind == "TradeEvent" and type(data) == "table" and data.Kind == "Ended" and tradeBusy then
        tradeBusy = false
        towerNote = ""
        startTower()
    elseif kind == "RaidState" then
        onRaidState(data)
    elseif kind == "RaidNotice" then
        raidNote = type(data) == "table" and tostring(data.message or data.Message or "") or tostring(data)
        if DEBUG then print("[FD raid] notice:", raidNote) end
    elseif kind == "RaidLeft" then
        raidJoined = false
    end
end

