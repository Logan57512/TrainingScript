----------------------------------------------------------------------
-- Auto Reconnect
----------------------------------------------------------------------
local reconnecting = false

local function queueSelf()
    local q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if type(q) ~= "function" then return end
    local code
    if SCRIPT_URL ~= "" then
        code = string.format("loadstring(game:HttpGet(%q))()", SCRIPT_URL)
    else
        code = string.format("if isfile and isfile(%q) then loadstring(readfile(%q))() end", SCRIPT_FILE, SCRIPT_FILE)
    end
    pcall(q, code)
end

local function reconnect()
    if reconnecting or not alive or not cfg.reconnect then return end
    reconnecting = true
    task.spawn(function()
        task.wait(2)
        local attempt = 0
        while alive and cfg.reconnect do
            attempt += 1
            reconnectNote = "reconnecting (try " .. attempt .. ")"
            queueSelf()
            pcall(function()
                if attempt == 1 then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                else
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end
            end)
            task.wait(math.min(30, 8 + attempt * 2))
        end
        reconnecting = false
        reconnectNote = ""
    end)
end

task.spawn(function()
    local ok, overlay = pcall(function()
        return CoreGui:WaitForChild("RobloxPromptGui", 15):WaitForChild("promptOverlay", 15)
    end)
    if ok and overlay then
        track(overlay.ChildAdded:Connect(function(c)
            if c.Name == "ErrorPrompt" then reconnect() end
        end))
    end
end)
track(GuiService.ErrorMessageChanged:Connect(function(msg)
    if msg ~= "" then reconnect() end
end))

