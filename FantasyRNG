local statTower, statRoll, statRaid, statNote = statLabel(262), statLabel(278), statLabel(294), statLabel(310)

local minimized = cfg.minimized

local function refresh()
    statTower.Text = string.format("%s · %s x%d · F%d · %d runs", curName, curDiff:sub(1, 4), curSpeed, floorNo, runs)
    statRoll.Text = string.format("Roll: %d · rej %d", rolls, rejects)

    local status
    if raidBusy then status = "fighting"
    elseif raidJoining then status = "joining"
    elseif raidJoined or LocalPlayer:GetAttribute("RaidQueuedUnit") ~= nil then status = "queued"
    else status = "waiting" end
    statRaid.Text = string.format("Raid: %s · %d joins · W/L %d/%d · %d hits", status, raidJoins, raidWins, raidLosses, raidStrikes)

    local note = reconnectNote ~= "" and reconnectNote or raidNote ~= "" and raidNote or towerNote
    if note == "" then
        note = cfg.afk and string.format("Anti-AFK on · %d resets", afkKicks) or ""
    end
    statNote.Text = note
end

