local function tween(o, t, props)
    TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- tower mode selector (segmented control)
do
    local seg = Instance.new("Frame")
    seg.Size = UDim2.new(1, -24, 0, 26)
    seg.Position = UDim2.fromOffset(12, 38)
    seg.BackgroundColor3 = PANEL
    seg.BorderSizePixel = 0
    seg.Parent = frame
    Instance.new("UICorner", seg).CornerRadius = UDim.new(0, 8)

    local buttons = {}
    local function render()
        for mode, b in pairs(buttons) do
            local on = cfg.mode == mode
            tween(b, 0.15, { BackgroundColor3 = on and ON_C or PANEL })
            b.TextColor3 = on and Color3.new(1, 1, 1) or DIM
        end
    end
    local function add(mode, text, xScale)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.5, -3, 1, -6)
        b.Position = UDim2.new(xScale, xScale == 0 and 3 or 0, 0, 3)
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.Text = text
        b.Parent = seg
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.Activated:Connect(function()
            if cfg.mode == mode then return end
            cfg.mode = mode
            buildTowers()
            saveCfg()
            render()
        end)
        buttons[mode] = b
    end
    add("ALL", "ALL TOWERS", 0)
    add("INFINITY", "INFINITY", 0.5)
    for mode, b in pairs(buttons) do
        b.BackgroundColor3 = cfg.mode == mode and ON_C or PANEL
        b.TextColor3 = cfg.mode == mode and Color3.new(1, 1, 1) or DIM
    end
end

local function makeToggle(y, label, initial, onChange)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, -24, 0, 28)
    row.Position = UDim2.fromOffset(12, y)
    row.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -56, 1, 0)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = TXT
    lbl.Text = label
    lbl.Parent = row

    local sw = Instance.new("TextButton")
    sw.AutoButtonColor = false
    sw.Text = ""
    sw.Size = UDim2.fromOffset(44, 22)
    sw.Position = UDim2.new(1, -44, 0.5, -11)
    sw.BorderSizePixel = 0
    sw.Parent = row
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(18, 18)
    knob.BorderSizePixel = 0
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.Parent = sw
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = initial
    local function render(animate)
        local col = state and ON_C or OFF_C
        local pos = state and UDim2.fromOffset(24, 2) or UDim2.fromOffset(2, 2)
        if animate then
            tween(sw, 0.16, { BackgroundColor3 = col })
            tween(knob, 0.16, { Position = pos })
        else
            sw.BackgroundColor3 = col
            knob.Position = pos
        end
    end
    render(false)

    sw.Activated:Connect(function()
        state = not state
        render(true)
        onChange(state)
    end)
end

