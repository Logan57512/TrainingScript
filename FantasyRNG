    local env = getgenv()
    if env.__FD_AUTO_CLEANUP then pcall(env.__FD_AUTO_CLEANUP) end
end

----------------------------------------------------------------------
-- Config (auto saved)
----------------------------------------------------------------------
local FULL_H, MIN_H = 250, 30

local cfg = {
    tower = true,        -- Auto Tower
    roll = true,         -- Auto Roll
    afk = true,          -- Anti-AFK
    reconnect = true,    -- Auto Reconnect
    mode = "ALL",        -- "ALL" | "INFINITY"
    minimized = false,
    pos = { 0, 18, 0.5, -FULL_H / 2 }, -- xScale, xOffset, yScale, yOffset
}

local canFile = type(readfile) == "function" and type(writefile) == "function" and type(isfile) == "function"

do
    if canFile then
        local ok, raw = pcall(function()
            if isfile(CFG_FILE) then return readfile(CFG_FILE) end
        end)
        if ok and raw then
            local ok2, t = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok2 and type(t) == "table" then
                for k, def in pairs(cfg) do
                    if type(t[k]) == type(def) then cfg[k] = t[k] end
                end
                if cfg.mode ~= "ALL" and cfg.mode ~= "INFINITY" then cfg.mode = "ALL" end
                local p = cfg.pos
                if #p ~= 4 or type(p[1]) ~= "number" or type(p[2]) ~= "number" or type(p[3]) ~= "number" or type(p[4]) ~= "number" then
                    cfg.pos = { 0, 18, 0.5, -FULL_H / 2 }
                end
            end
        end
    end
end

local saveQueued = false
local function saveCfg()
    if not canFile or saveQueued then return end
    saveQueued = true
    task.delay(0.5, function()
        saveQueued = false
        pcall(function() writefile(CFG_FILE, HttpService:JSONEncode(cfg)) end)
    end)
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local alive = true
local conns = {}
local function track(c) conns[#conns + 1] = c return c end

-- roll
local ROLL_DELAY = 0.1
local rolls, rejects = 0, 0

-- tower
local allTowers = {}
local towers = {}
local tIdx = 1
local inRun, tradeBusy = false, false
local lastStartSent, lastTowerEvt, lastTowerName = 0, 0, ""
local retryDelay = 0.5
local blocked = {}
local runs, floorNo, curName, towerNote = 0, 0, "-", ""

-- misc
local reconnectNote = ""
local afkKicks = 0

do
    local ok, all = pcall(function()
        return require(ReplicatedStorage.FantasyDice.TowerConfig).GetAll()
    end)
    if ok and type(all) == "table" then
        local tmp = {}
        for name, t in pairs(all) do tmp[#tmp + 1] = { name = name, order = t.order or 99 } end
        table.sort(tmp, function(a, b) return a.order < b.order end)
        for _, t in ipairs(tmp) do allTowers[#allTowers + 1] = t.name end
    end
    if #allTowers == 0 then
        allTowers = { "Dragon Tower", "Cursed Tower", "Pirate Tower", "Hidden Leaf Tower", "Infinity Tower" }
    end
end

local function buildTowers()
    if cfg.mode == "INFINITY" then
        towers = { "Infinity Tower" }
    else
        towers = table.clone(allTowers)
    end
    tIdx = 1
    blocked = {}
end
buildTowers()

----------------------------------------------------------------------
-- Roll (fixed interval, animation skipped)
--   a "Roll" request every ROLL_DELAY seconds; each "Rolled" is acknowledged with "RollLanded(token)" at once
----------------------------------------------------------------------
local function onRolled(d)
    rolls += 1
    if type(d) == "table" and d.Token ~= nil then
        Event:FireServer("RollLanded", d.Token)
    end
end

local function onRollRejected()
    rejects += 1
end

----------------------------------------------------------------------
-- Tower (restart immediately after "ended")
----------------------------------------------------------------------
local function pickTower()
    local n = #towers
    for i = 0, n - 1 do
        local k = (tIdx - 1 + i) % n + 1
        if (blocked[towers[k]] or 0) <= os.clock() then
            tIdx = k
            return towers[k]
        end
    end
end

local function advance()
    if #towers > 1 then tIdx = tIdx % #towers + 1 end
end

local function startTower()
    if not (alive and cfg.tower) or inRun or tradeBusy then return end
    local name = pickTower()
    if not name then
        towerNote = "all towers locked, retrying"
        task.delay(5, startTower)
        return
    end
    towerNote = ""
    lastTowerName = name
    lastStartSent = os.clock()
    Event:FireServer("Tower", { Op = "Start", Name = name, Auto = true })
end

local function onTowerEvent(d)
    if type(d) ~= "table" then return end
    lastTowerEvt = os.clock()
    local a = d.Action
    if a == "started" then
        inRun = true
        retryDelay = 0.5
        curName = d.Name or lastTowerName
        floorNo = 1
    elseif a == "floorStarted" then
        floorNo = d.Floor or floorNo
    elseif a == "ended" then
        inRun = false
        runs += 1
        advance()
        startTower()
    elseif a == "startRejected" then
        if d.Code == "TradeBusy" then
            tradeBusy = true
            towerNote = "trade busy, waiting"
        elseif d.Retryable == false then
            blocked[lastTowerName] = os.clock() + 30
            towerNote = tostring(d.Reason or "start refused")
            advance()
            task.delay(0.3, startTower)
        else
            retryDelay = math.min(3, retryDelay * 1.5)
            task.delay(retryDelay, startTower)
        end
    end
end

----------------------------------------------------------------------
-- Auto claim quests (native, no UI)
--   FireServer("Feature", {Op="QuestClaim", Period, Id, ExpiresAt, RequestId})  ->  ("QuestResult", {RequestId, Quests, ...})
--   Quest state arrives in ("State", {Quests = {Daily|Weekly = {progress, claimed, expiresAt}}})
----------------------------------------------------------------------
local QuestConfig
do
    local ok, mod = pcall(function()
        return require(ReplicatedStorage.FantasyDice.StallSystems.QuestConfig)
    end)
    if ok and type(mod) == "table" and mod.Periods then QuestConfig = mod end
end

local questState = nil          -- latest Quests table from the server
local questReq = 1000000        -- high range so ids never collide with the game's own UI counter
local questPending, questPendingAt = nil, 0

local function checkQuests()
    if not (alive and QuestConfig and questState) then return end
    if questPending and os.clock() - questPendingAt < 3 then return end
    questPending = nil

    for _, period in ipairs({ "Daily", "Weekly" }) do
        local q, pcfg = questState[period], QuestConfig.Periods[period]
        if type(q) == "table" and pcfg then
            local claimed, progress = q.claimed or {}, q.progress or {}
            for _, quest in ipairs(pcfg.quests) do
                if not claimed[quest.id] and (progress[quest.id] or 0) >= quest.target then
                    questReq += 1
                    questPending, questPendingAt = questReq, os.clock()
                    Event:FireServer("Feature", {
                        Op = "QuestClaim",
                        Period = period,
                        Id = quest.id,
                        ExpiresAt = q.expiresAt,
                        RequestId = questReq,
                    })
                    return -- one at a time; the result triggers the next
                end
            end
        end
    end
end

----------------------------------------------------------------------
-- Remote dispatcher
----------------------------------------------------------------------
local function dispatch(kind, data)
    if kind == "Rolled" then
        if cfg.roll then onRolled(data) end
    elseif kind == "RollRejected" then
        if cfg.roll then onRollRejected() end
    elseif kind == "TowerEvent" then
        if cfg.tower then onTowerEvent(data) end
    elseif kind == "State" then
        if type(data) == "table" and type(data.Quests) == "table" then questState = data.Quests end
    elseif kind == "QuestResult" then
        if type(data) == "table" then
            if type(data.Quests) == "table" then questState = data.Quests end
            if data.RequestId == questPending then questPending = nil end
            task.defer(checkQuests)
        end
    elseif kind == "TradeEvent" and type(data) == "table" and data.Kind == "Ended" and tradeBusy then
        tradeBusy = false
        towerNote = ""
        startTower()
    end
end

----------------------------------------------------------------------
-- Feature switches
----------------------------------------------------------------------
local function setRoll(v)
    cfg.roll = v
    saveCfg()
end

local function setTower(v)
    cfg.tower = v
    saveCfg()
    if v then
