-- Walk children from their known parent rather than joining cloned references
-- or relying on GetDescendants returning parents before their descendants.
local function buildTree(root, nodeMap)
	local rootNode = nodeMap[root] or {Obj = root}
	nodeMap[root] = rootNode
	local pending, visited = {rootNode}, {}
	local unreadable = 0
	while #pending > 0 do
		local parent = table.remove(pending)
		if visited[parent.Obj] then continue end
		visited[parent.Obj] = true
		local ok, children = pcall(function() return parent.Obj:GetChildren() end)
		if not ok or type(children) ~= "table" then
			unreadable += 1
			continue
		end
		for _, child in ipairs(children) do
			local node = nodeMap[child]
			if not node then
				node = {Obj = child, Parent = parent}
				nodeMap[child] = node
				parent[#parent + 1] = node
				parent.Sorted = nil
			end
			pending[#pending + 1] = node
		end
	end
	return rootNode, unreadable
end

local function main()
	local Explorer = {}
