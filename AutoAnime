-- Helper Functions
local function GetRarityOfCharacter(charName)
    if not charName or charName == "" then return "Unknown" end
    for rarity, list in pairs(CharacterRarityMap) do
        if rarity ~= "Pre-Selected" then
            for _, name in ipairs(list) do
                if string.lower(name) == string.lower(charName) then
                    return rarity
                end
            end
        end
    end
    return "Unknown"
end

local function GetToolUUID(tool)
    -- Added UDID support as well just in case
    local uuid = tool:GetAttribute("UUID") or tool:GetAttribute("uuid") or tool:GetAttribute("UDID") or tool:GetAttribute("ID") or tool:GetAttribute("Id")
    if uuid then return tostring(uuid) end
    for _, child in ipairs(tool:GetChildren()) do
        if child:IsA("ValueBase") then
            local cName = string.lower(child.Name)
            if cName:find("uuid") or cName:find("udid") or cName:find("guid") or cName:find("id") then
                return tostring(child.Value)
            end
        end
    end
    return nil
end

local function GetToolMutation(tool)
    local mut = tool:GetAttribute("Mutation") or tool:GetAttribute("mutation") or tool:GetAttribute("Buff")
    if mut then return tostring(mut) end
    local mutVal = tool:FindFirstChild("Mutation") or tool:FindFirstChild("Buff")
    if mutVal and mutVal:IsA("ValueBase") then return tostring(mutVal.Value) end
    return "No Mutation"
end

local function GetBestCloneUUID(targetName)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local bestTool = nil
    local bestRank = -1
    local bestLevel = -1

    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and string.lower(item.Name) == string.lower(targetName) then
            -- Determine Mutation Rank
            local mut = GetToolMutation(item)
            local mutName = string.lower(mut)
            local rank = CloneMutationRanks[mutName] or 0

            -- Determine Level
            local level = tonumber(item:GetAttribute("Level") or item:GetAttribute("level"))
            if not level then
                local lvlVal = item:FindFirstChild("Level") or item:FindFirstChild("level")
                if lvlVal and lvlVal:IsA("ValueBase") then
                    level = tonumber(lvlVal.Value)
                end
            end
            level = level or 0

            -- Compare Best (Rank prioritized, then Level tie-breaker)
            if rank > bestRank or (rank == bestRank and level > bestLevel) then
                bestRank = rank
                bestLevel = level
                bestTool = item
            end
        end
    end

    if bestTool then
        return GetToolUUID(bestTool)
    end
    return nil
end

