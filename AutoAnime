task.spawn(function()
    while true do
        if FastAutoCloneEnabled or AFKAutoCloneEnabled then
            -- Assign speed based on which is enabled
            local delayTime = FastAutoCloneEnabled and 0.1 or 20.0
            
            pcall(function()
                local CloneRemote = ReplicatedStorage.Remotes.CloneRemotes.Request
                
                -- Always attempt to claim if we cached a UUID previously
                if CurrentCloningUUID then
                    CloneRemote:FireServer("Claim", {
                        UUID = CurrentCloningUUID,
                        CharacterId = CurrentCloningUUID
                    })
                end
                
                -- Search Backpack for best specific target 
                local bestUUID = GetBestCloneUUID(CloneTarget)
                if bestUUID then
                    -- Fail-safe claim: Just in case the server logic holds up and needs the new UUID to register a claim
                    CloneRemote:FireServer("Claim", {
                        UUID = bestUUID,
                        CharacterId = bestUUID
                    })
                    
                    -- Start cloning the best unit found
                    CloneRemote:FireServer("Start", {
                        UUID = bestUUID,
                        CharacterId = bestUUID
                    })
                    
                    -- Cache UUID to claim it successfully in the next loops
                    CurrentCloningUUID = bestUUID
                end
            end)
            
            task.wait(delayTime)
        else
            task.wait(1)
        end
    end
end)

